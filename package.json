{
  "name": "deepseek-harness-desktop",
  "version": "1.1.0",
  "description": "DeepSeek Harness 桌面客户端 —— 原生窗口包裹 DSH Web 界面 + 插件/技能/MCP 注册表 + 本地工具调用补丁",
  "author": "jiangchuangege",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prestart": "esbuild scripts/pet-live2d-entry.js --bundle --format=iife --minify --outfile=assets/pet-live2d.js",
    "dist": "electron-builder",
    "predist": "esbuild scripts/pet-live2d-entry.js --bundle --format=iife --minify --outfile=assets/pet-live2d.js"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10"
  },
  "build": {
    "appId": "com.jiangchuangege.harnessdesktop",
    "productName": "DeepSeek Harness 桌面客户端",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "pet.html",
      "chat.html",
      "plugins.html",
      "notice.html",
      "config/**/*",
      "scripts/**/*",
      "assets/**/*",
      "docs/**/*",
      "README.md",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
